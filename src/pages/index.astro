---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section id="hero" class="section hero">
				<p class="eyebrow">[TODO 0.1 — Posicionamiento]</p>
				<h1>Frase de posicionamiento aquí.</h1>
				<p class="lead">
					Subtítulo / propuesta de valor en una línea. Pendiente de redactar
					con la skill <code>/posicionamiento</code>.
				</p>
				<div class="cta-row">
					<a class="cta" href="#projects">Ver proyectos</a>
					<a class="cta cta-secondary" href="#contact">Contacto</a>
				</div>
			</section>

			<section id="approach" class="section">
				<h2>Approach</h2>
				<p class="placeholder">
					[TODO 2.3 — Sobre / Approach. Integrar filosofía-fisiología-ingeniería-psicología
					sin grandilocuencia. Tesis: "lo que no cambia en los sistemas complejos".]
				</p>
			</section>

			<section id="projects" class="section">
				<h2>Proyectos</h2>
				<div class="grid">
					<article class="card">
						<h3>NormaBot — Agentic RAG sobre regulación de IA</h3>
						<p>
							Sistema agentic (ReAct + LangGraph) que consulta normativa española
							y europea sobre IA, clasifica sistemas por nivel de riesgo (EU AI Act)
							y genera checklists de cumplimiento. RAG correctivo con grading local
							(Ollama) + clasificador XGBoost con SHAP + side-channel para citas
							verificadas (anti-alucinación).
						</p>
						<p class="meta">
							Proyecto de equipo. Mi aporte: arquitectura del agente, side-channel
							anti-alucinación, memoria conversacional, pipeline de datos, liderazgo
							del equipo. <a href="https://github.com/mariaeugenia-alvarez/proyecto-final">Repo</a>
						</p>
						<a class="cta-link" href="#">Caso de estudio → [TODO 3.6]</a>
					</article>
					<article class="card">
						<h3>Evaluación &amp; observabilidad sobre producto SaaS en producción</h3>
						<p>
							Colaboración con <em>Deepgent</em>: añadiendo capa de evaluación
							(RAGAS) y observabilidad (LangFuse) sobre un chatbot/KB de producción
							ya en uso. Objetivo: hacer medible el sistema, fijar baseline y
							demostrar mejora iterativa con delta numérico.
						</p>
						<p class="meta">
							Estado: work-in-progress. KPIs objetivo: faithfulness, coste/req,
							latencia p50/p95, hotspots por endpoint.
						</p>
						<a class="cta-link" href="#">Caso de estudio → [TODO 3.6]</a>
					</article>
					<article class="card placeholder-card">
						<h3>Tercer proyecto — por decidir</h3>
						<p>
							Candidato: optimización coste/latencia (cascade de modelos con
							benchmark honesto). Decisión condicionada a tiempo restante tras
							cerrar los dos casos de estudio anteriores.
						</p>
					</article>
				</div>
			</section>

			<section id="skills" class="section">
				<h2>Skills &amp; Stack</h2>
				<p class="placeholder">[TODO 2.6 — Listado limpio, sin barritas de progreso.]</p>
				<ul class="skills">
					<li>Python</li>
					<li>PyTorch / scikit-learn</li>
					<li>LLMs / RAG</li>
					<li>MLOps</li>
					<li>Lean / mejora continua</li>
				</ul>
			</section>

			<section id="blog" class="section">
				<h2>Blog</h2>
				<p class="placeholder">
					Notas sobre lo que no cambia en los sistemas complejos.
				</p>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</li>
						))
					}
				</ul>
				<a class="more" href="/blog">Ver todos los artículos →</a>
			</section>

			<section id="contact" class="section">
				<h2>Contacto</h2>
				<p class="placeholder">[TODO 2.7 — Email, LinkedIn, GitHub, CV.]</p>
				<ul class="contact-list">
					<li>Email: <a href="mailto:pablofdi@gmail.com">pablofdi@gmail.com</a></li>
					<li>LinkedIn: <a href="#">pendiente</a></li>
					<li>GitHub: <a href="#">pendiente</a></li>
				</ul>
			</section>
		</main>
		<Footer />

		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em;
			}
			.section {
				margin: 0 0 4em;
			}
			.hero {
				padding: 2em 0 1em;
			}
			.eyebrow {
				font-size: 0.85rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgb(var(--gray));
				margin: 0 0 0.5em;
			}
			h1 {
				font-size: 2.4rem;
				line-height: 1.15;
				margin: 0 0 0.4em;
			}
			h2 {
				font-size: 1.6rem;
				margin: 0 0 0.6em;
				border-bottom: 1px solid rgb(var(--gray-light));
				padding-bottom: 0.3em;
			}
			.lead {
				font-size: 1.15rem;
				color: rgb(var(--gray-dark));
				margin: 0 0 1.4em;
			}
			.placeholder {
				color: rgb(var(--gray));
				font-style: italic;
			}
			.cta-row {
				display: flex;
				gap: 0.8em;
				flex-wrap: wrap;
			}
			.cta {
				display: inline-block;
				padding: 0.6em 1.2em;
				background: var(--accent);
				color: white;
				border-radius: 6px;
				text-decoration: none;
			}
			.cta-secondary {
				background: transparent;
				color: var(--accent);
				border: 1px solid var(--accent);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1.2em;
				margin-top: 1em;
			}
			.card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				padding: 1.2em;
			}
			.card h3 {
				margin: 0 0 0.4em;
			}
			.card .meta {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin: 0.4em 0 0.6em;
			}
			.cta-link {
				font-size: 0.9rem;
			}
			.placeholder-card {
				border-style: dashed;
				background: transparent;
				color: rgb(var(--gray));
			}
			.skills {
				list-style: none;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			.skills li {
				border: 1px solid rgb(var(--gray-light));
				padding: 0.3em 0.7em;
				border-radius: 999px;
				font-size: 0.9rem;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 1em 0;
			}
			.post-list li {
				padding: 0.4em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.more {
				display: inline-block;
				margin-top: 0.8em;
			}
			.contact-list {
				list-style: none;
				padding: 0;
			}
			.contact-list li {
				padding: 0.3em 0;
			}
			@media (max-width: 720px) {
				h1 {
					font-size: 1.9rem;
				}
			}
		</style>
	</body>
</html>
